{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "srcMove results schema 3",
  "description": "Structural contract only; reference, count, evidence-state, and XML invariants require semantic validation.",
  "type": "object",
  "properties": {
    "results_schema_version": {
      "const": 3
    },
    "summary": {
      "type": "object",
      "properties": {
        "output_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "atomic_move_group_count": {
          "type": "integer",
          "minimum": 0
        },
        "sequence_move_group_count": {
          "type": "integer",
          "minimum": 0
        },
        "pair_capacity": {
          "type": "integer",
          "minimum": 0
        },
        "endpoint_count": {
          "type": "integer",
          "minimum": 0
        },
        "atomic_content_relationships": {
          "$ref": "#/$defs/histogram"
        },
        "output_content_relationships": {
          "$ref": "#/$defs/histogram"
        }
      },
      "required": [
        "output_item_count",
        "atomic_move_group_count",
        "sequence_move_group_count",
        "pair_capacity",
        "endpoint_count",
        "atomic_content_relationships",
        "output_content_relationships"
      ],
      "additionalProperties": false
    },
    "output_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outputItem"
      }
    },
    "atomic_move_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/atomicGroup"
      }
    },
    "configuration": {
      "type": "object",
      "properties": {
        "min_granularity": {
          "enum": [
            "statement",
            "fragment"
          ]
        },
        "sequence_policy": {
          "const": "ordered_adjacent_v1"
        }
      },
      "required": [
        "min_granularity",
        "sequence_policy"
      ],
      "additionalProperties": false
    },
    "pipeline_statistics": {
      "type": "object",
      "properties": {
        "srcdiff_region_count": {
          "type": "integer",
          "minimum": 0
        },
        "grouped_candidate_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "processing_group_count": {
          "type": "integer",
          "minimum": 0
        },
        "processing_group_kinds": {
          "type": "object",
          "properties": {
            "move_1_to_1": {
              "type": "integer",
              "minimum": 0
            },
            "moves_many": {
              "type": "integer",
              "minimum": 0
            },
            "delete_only": {
              "type": "integer",
              "minimum": 0
            },
            "insert_only": {
              "type": "integer",
              "minimum": 0
            },
            "copy_or_repeat": {
              "type": "integer",
              "minimum": 0
            },
            "ambiguous": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "move_1_to_1",
            "moves_many",
            "delete_only",
            "insert_only",
            "copy_or_repeat",
            "ambiguous"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "srcdiff_region_count",
        "grouped_candidate_entry_count",
        "processing_group_count",
        "processing_group_kinds"
      ],
      "additionalProperties": false
    },
    "xpath_context": {
      "type": "object",
      "properties": {
        "document": {
          "const": "input_srcdiff"
        },
        "namespaces": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "properties": {
            "src": {
              "const": "http://www.srcML.org/srcML/src"
            },
            "diff": {
              "const": "http://www.srcML.org/srcDiff"
            },
            "mv": {
              "const": "http://www.srcML.org/srcMove"
            }
          },
          "required": [
            "src",
            "diff"
          ]
        },
        "convention": {
          "const": "srcreader_file_units_v1"
        }
      },
      "required": [
        "document",
        "namespaces",
        "convention"
      ],
      "additionalProperties": false
    },
    "diagnostics": {
      "$ref": "#/$defs/diagnostics"
    }
  },
  "required": [
    "results_schema_version",
    "summary",
    "output_items",
    "atomic_move_groups",
    "configuration",
    "pipeline_statistics",
    "xpath_context"
  ],
  "additionalProperties": false,
  "$defs": {
    "histogram": {
      "type": "object",
      "properties": {
        "type1": {
          "type": "integer",
          "minimum": 0
        },
        "type2c": {
          "type": "integer",
          "minimum": 0
        },
        "type3": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type1",
        "type2c",
        "type3"
      ],
      "additionalProperties": false
    },
    "endpoint": {
      "type": "object",
      "properties": {
        "candidate_id": {
          "type": "integer",
          "minimum": 0
        },
        "revision_file": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "xpath": {
          "type": "string",
          "pattern": "^/"
        },
        "construct": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_text": {
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "revision_file",
        "xpath",
        "construct",
        "raw_text"
      ],
      "additionalProperties": false
    },
    "observations": {
      "type": "object",
      "properties": {
        "file": {
          "enum": [
            "same",
            "different",
            "unknown"
          ]
        },
        "semantic_container": {
          "enum": [
            "same_mapped",
            "different_mapped",
            "unknown"
          ]
        },
        "anchor_interval": {
          "enum": [
            "same",
            "different",
            "crossed",
            "unknown",
            "same_within_parent"
          ]
        },
        "relative_order": {
          "enum": [
            "unchanged",
            "crossed_stable_sibling",
            "unknown"
          ]
        },
        "ancestor": {
          "enum": [
            "same",
            "wrapped",
            "unwrapped",
            "incompatible",
            "unknown"
          ]
        }
      },
      "required": [
        "file",
        "semantic_container",
        "anchor_interval",
        "relative_order",
        "ancestor"
      ],
      "additionalProperties": false
    },
    "parentPair": {
      "type": "object",
      "properties": {
        "original_candidate_id": {
          "type": "integer",
          "minimum": 0
        },
        "modified_candidate_id": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "original_candidate_id",
        "modified_candidate_id"
      ],
      "additionalProperties": false
    },
    "pairLocation": {
      "type": "object",
      "properties": {
        "scope": {
          "const": "pair"
        },
        "classification": {
          "enum": [
            "stationary",
            "relocated",
            "restructured",
            "ambiguous"
          ]
        },
        "reason": {
          "enum": [
            "same_anchor_interval",
            "different_file",
            "different_semantic_container",
            "different_structural_region",
            "stable_in_corresponding_region",
            "crossed_stable_sibling",
            "ancestor_wrapped",
            "ancestor_unwrapped",
            "stable_relative_to_relocated_parent",
            "incompatible_context",
            "insufficient_context"
          ]
        },
        "observations": {
          "$ref": "#/$defs/observations"
        },
        "carried_by_parent": {
          "type": "boolean"
        },
        "parent_pair": {
          "anyOf": [
            {
              "$ref": "#/$defs/parentPair"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "scope",
        "classification",
        "reason",
        "observations",
        "carried_by_parent",
        "parent_pair"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "carried_by_parent": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "parent_pair": {
                "$ref": "#/$defs/parentPair"
              }
            }
          },
          "else": {
            "properties": {
              "parent_pair": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "groupLocation": {
      "type": "object",
      "properties": {
        "scope": {
          "const": "group"
        },
        "status": {
          "const": "group_relocation_evidence"
        }
      },
      "required": [
        "scope",
        "status"
      ],
      "additionalProperties": false
    },
    "unassessedLocation": {
      "type": "object",
      "properties": {
        "scope": {
          "const": "not_assessed"
        },
        "reason": {
          "const": "continuing_source_copy"
        }
      },
      "required": [
        "scope",
        "reason"
      ],
      "additionalProperties": false
    },
    "unclassifiedPairLocation": {
      "type": "object",
      "properties": {
        "scope": {"const": "not_assessed"},
        "reason": {"const": "no_classified_pair"}
      },
      "required": ["scope", "reason"],
      "additionalProperties": false
    },
    "location": {
      "oneOf": [
        {
          "$ref": "#/$defs/productionPairLocation"
        },
        {
          "$ref": "#/$defs/groupLocation"
        },
        {
          "$ref": "#/$defs/unassessedLocation"
        },
        {
          "$ref": "#/$defs/unclassifiedPairLocation"
        }
      ]
    },
    "correspondence": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "selected_pair",
            "unresolved_partners",
            "copy_source_set"
          ]
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "matching_weight_milli": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "utility": {
          "type": "integer",
          "minimum": 0
        },
        "matched_units": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "enum": [
            "greedy_utility",
            "exact_neighbor_correspondence",
            "continuing_source_copy",
            "unresolved_exact_residual",
            "descendant_bundle"
          ]
        }
      },
      "required": [
        "matching_weight_milli",
        "utility",
        "matched_units",
        "reason"
      ],
      "additionalProperties": false
    },
    "atomicGroup": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "content_relationship": {
          "enum": [
            "type1",
            "type2c",
            "type3"
          ]
        },
        "correspondence": {
          "$ref": "#/$defs/correspondence"
        },
        "name_evidence": {
          "$ref": "#/$defs/nameEvidence"
        },
        "original": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          },
          "minItems": 1
        },
        "modified": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          },
          "minItems": 1
        },
        "location_evidence": {
          "$ref": "#/$defs/location"
        },
        "selection": {
          "$ref": "#/$defs/selection"
        }
      },
      "required": [
        "id",
        "content_relationship",
        "correspondence",
        "name_evidence",
        "original",
        "modified",
        "location_evidence",
        "selection"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "content_relationship": {
                "const": "type1"
              }
            }
          },
          "then": {
            "properties": {
              "name_evidence": {
                "const": "not_assessed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "correspondence": {
                "properties": {
                  "status": {
                    "const": "selected_pair"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "location_evidence": {
                "oneOf": [
                  {"$ref": "#/$defs/productionPairLocation"},
                  {"$ref": "#/$defs/unclassifiedPairLocation"}
                ]
              },
              "original": {
                "minItems": 1,
                "maxItems": 1
              },
              "modified": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "location_evidence": {"$ref": "#/$defs/unclassifiedPairLocation"}
            }
          },
          "then": {
            "properties": {
              "content_relationship": {"const": "type1"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "correspondence": {
                "properties": {
                  "status": {
                    "const": "unresolved_partners"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "location_evidence": {
                "$ref": "#/$defs/groupLocation"
              },
              "content_relationship": {
                "const": "type1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "correspondence": {
                "properties": {
                  "status": {
                    "const": "copy_source_set"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "location_evidence": {
                "$ref": "#/$defs/unassessedLocation"
              },
              "content_relationship": {
                "const": "type1"
              }
            }
          }
        }
      ]
    },
    "sequenceEndpoint": {
      "type": "object",
      "properties": {
        "revision_file": {
          "type": "string",
          "minLength": 1
        },
        "parent_id": {
          "type": "string",
          "minLength": 1
        },
        "first_child_ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "last_child_ordinal": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "revision_file",
        "parent_id",
        "first_child_ordinal",
        "last_child_ordinal"
      ],
      "additionalProperties": false
    },
    "sequence": {
      "type": "object",
      "properties": {
        "policy": {
          "const": "ordered_adjacent_v1"
        },
        "original": {
          "$ref": "#/$defs/sequenceEndpoint"
        },
        "modified": {
          "$ref": "#/$defs/sequenceEndpoint"
        }
      },
      "required": [
        "policy",
        "original",
        "modified"
      ],
      "additionalProperties": false
    },
    "atomicItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^item:.+"
        },
        "kind": {
          "const": "atomic_move_group"
        },
        "member_group_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": [
        "id",
        "kind",
        "member_group_ids"
      ],
      "additionalProperties": false
    },
    "sequenceItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sequence:.+"
        },
        "kind": {
          "const": "sequence_move_group"
        },
        "member_group_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2
        },
        "sequence": {
          "$ref": "#/$defs/sequence"
        }
      },
      "required": [
        "id",
        "kind",
        "member_group_ids",
        "sequence"
      ],
      "additionalProperties": false
    },
    "outputItem": {
      "oneOf": [
        {
          "$ref": "#/$defs/atomicItem"
        },
        {
          "$ref": "#/$defs/sequenceItem"
        }
      ]
    },
    "diagnosticCandidate": {
      "type": "object",
      "properties": {
        "candidate_id": {
          "type": "integer",
          "minimum": 0
        },
        "revision": {
          "enum": [
            "original",
            "modified"
          ]
        },
        "selected_group_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "endpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/endpoint"
            },
            {
              "type": "null"
            }
          ]
        },
        "type3_eligible": {
          "type": "boolean"
        },
        "line_units": {
          "type": "integer",
          "minimum": 0
        },
        "token_units": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "enum": [
            "diff_wrapper",
            "single_child_wrapper",
            "multi_child_wrapper",
            "structural_child"
          ]
        }
      },
      "required": [
        "candidate_id",
        "revision",
        "selected_group_id",
        "endpoint",
        "type3_eligible",
        "line_units",
        "token_units",
        "role"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "selected_group_id": {
              "type": "string",
              "minLength": 1
            },
            "endpoint": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "selected_group_id": {
              "type": "null"
            },
            "endpoint": {
              "$ref": "#/$defs/endpoint"
            }
          }
        }
      ]
    },
    "endpointContext": {
      "type": "object",
      "properties": {
        "revision_file": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "semantic_container_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "semantic_container_label": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_common_anchor_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "next_common_anchor_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "meaningful_ancestors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ancestor_summary_interpretable": {
          "type": "boolean"
        },
        "structural_region_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "structural_region_mapped": {
          "type": "boolean"
        },
        "common_sibling_prefix_count": {
          "type": "integer",
          "minimum": 0
        },
        "common_sibling_suffix_begin": {
          "type": "integer",
          "minimum": 0
        },
        "anchor_region_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "revision_file",
        "semantic_container_id",
        "semantic_container_label",
        "previous_common_anchor_id",
        "next_common_anchor_id",
        "meaningful_ancestors",
        "ancestor_summary_interpretable",
        "structural_region_id",
        "structural_region_mapped",
        "common_sibling_prefix_count",
        "common_sibling_suffix_begin",
        "anchor_region_id"
      ],
      "additionalProperties": false
    },
    "correspondenceSelection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "selected_pair"
            },
            "selected_group_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "selected_group_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "not_selected_pair"
            },
            "selected_group_id": {
              "type": "null"
            }
          },
          "required": [
            "status",
            "selected_group_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "diagnosticCorrespondence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "original_candidate_id": {
          "type": "integer",
          "minimum": 0
        },
        "modified_candidate_id": {
          "type": "integer",
          "minimum": 0
        },
        "content_relationship": {
          "enum": [
            "type1",
            "type2c",
            "type3"
          ]
        },
        "location": {
          "$ref": "#/$defs/pairLocation"
        },
        "original_context": {
          "$ref": "#/$defs/endpointContext"
        },
        "modified_context": {
          "$ref": "#/$defs/endpointContext"
        },
        "verified_partner_counts": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "original": {
                  "type": "integer",
                  "minimum": 1
                },
                "modified": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "original",
                "modified"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "selection": {
          "$ref": "#/$defs/correspondenceSelection"
        },
        "name_evidence": {
          "$ref": "#/$defs/diagnosticNameEvidence"
        }
      },
      "required": [
        "id",
        "original_candidate_id",
        "modified_candidate_id",
        "content_relationship",
        "name_evidence",
        "location",
        "original_context",
        "modified_context",
        "verified_partner_counts",
